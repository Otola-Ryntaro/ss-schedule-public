# Copy to .env.local and fill in values. .env.local is gitignored.

# Gemini API (server-side only). @google/genai SDK auto-reads GEMINI_API_KEY.
GEMINI_API_KEY=

# Auth.js v5 + Google Provider
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# E2E only — Playwright auto-injects via playwright.config.ts. Do NOT set this here.
# Setting E2E_AUTH_BYPASS=1 in .env.local would enable the test-only Credentials Provider
# during normal `bun dev` runs.
# E2E_AUTH_BYPASS=1
