# .env.vercel.template — Vercel 本番デプロイ用環境変数テンプレート（値は空）
#
# 使い方 A: Vercel ダッシュボードから一括 import
#   Settings → Environment Variables → Import .env File → 本ファイルを選択 → 各値を編集
#
# 使い方 B: CLI で一括登録
#   1. cp .env.vercel.template .env.vercel.local
#   2. .env.vercel.local の値を実値に書き換え（このファイル自体は .gitignored）
#   3. bash scripts/vercel-env-setup.sh で Production/Preview/Development 全環境に一括登録
#
# Production / Preview / Development すべてに同じ値を設定する（OAuth callback の不一致を防ぐため）
# AUTH_URL は初回デプロイ後に Vercel が割り当てた URL に書き換える

# Gemini API (server-side only). @google/genai SDK auto-reads GEMINI_API_KEY.
GEMINI_API_KEY=

# Auth.js v5 + Google Provider
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 本番用 AUTH_SECRET は local と別値を生成すること: openssl rand -base64 32
AUTH_SECRET=

# 初回デプロイ後に Vercel が割り当てた URL に書き換える (例: https://ss-schedule.vercel.app)
AUTH_URL=
